{
  "info": {
    "_postman_id": "smart-building-api",
    "name": "Smart Building & Industrial IoT API",
    "description": "Collection for testing Smart Building and Industrial IoT endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Machines",
      "item": [
        {
          "name": "Create Machine",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machineCode\": \"CNC_MILL_001\",\n  \"machineType\": \"CNC_MILL\",\n  \"locationZone\": \"Zone A\",\n  \"floorNumber\": 4,\n  \"installDate\": \"2024-01-15\"\n}"
            },
            "url": {
              "raw": "{{host}}/api/v1/machines",
              "host": ["{{host}}"],
              "path": ["api", "v1", "machines"]
            }
          }
        },
        {
          "name": "List Machines",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{host}}/api/v1/machines?page=1&limit=10",
              "host": ["{{host}}"],
              "path": ["api", "v1", "machines"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "machineType",
                  "value": "CNC_MILL",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Get Machine",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{host}}/api/v1/machines/{{machineId}}",
              "host": ["{{host}}"],
              "path": ["api", "v1", "machines", "{{machineId}}"]
            }
          }
        },
        {
          "name": "Activate Machine",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{host}}/api/v1/machines/{{machineId}}/activate",
              "host": ["{{host}}"],
              "path": ["api", "v1", "machines", "{{machineId}}", "activate"]
            }
          }
        },
        {
          "name": "Deactivate Machine",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{host}}/api/v1/machines/{{machineId}}/deactivate",
              "host": ["{{host}}"],
              "path": ["api", "v1", "machines", "{{machineId}}", "deactivate"]
            }
          }
        }
      ]
    },
